# ─── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── JSearch (RapidAPI) ────────────────────────────────────────
# Sign up free at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your-rapidapi-key-here

# ─── Admin ────────────────────────────────────────────────────
# Any secret string — used to protect /api/crawler routes
ADMIN_KEY=change-this-to-a-secret-string

# ─── App ──────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Crawl ────────────────────────────────────────────────────
# The process runs a quick crawl about 20s after boot, then every 6 hours,
# and a full crawl daily at 02:00 UTC. Set this to false to disable the boot crawl.
CRAWL_ON_BOOT=true

# Optional page caps. Defaults: quick 6 Workday / 8 Oracle pages, full is higher.
# WORKDAY_PAGE_CAP=6
# ORACLE_PAGE_CAP=8

# After you run schema-last-seen.sql, set this so each upsert stamps last_seen_at.
# Leave it unset until the column exists — sending an unknown column fails the upsert.
JOBS_HAS_LAST_SEEN=false

# Published CSV of hand-added jobs. Optional.
# MANUAL_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv
